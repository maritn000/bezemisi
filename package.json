{
  "name": "bezemisi",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "vercel-build": "bash scripts/vercel-build.sh",
    "catalogue:bootstrap": "tsx --require ./scripts/mock-server-only.cjs -r tsconfig-paths/register scripts/vercel-catalogue-bootstrap.ts",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --require ./scripts/mock-server-only.cjs --test src/**/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:verify": "tsx -r tsconfig-paths/register scripts/verify-db.ts",
    "db:inspect": "tsx -r tsconfig-paths/register scripts/inspect-db.ts",
    "db:prepare-bootstrap": "tsx --require ./scripts/mock-server-only.cjs -r tsconfig-paths/register scripts/prepare-catalogue-bootstrap.ts",
    "catalogue:discover": "tsx -r tsconfig-paths/register scripts/catalogue/discover.ts",
    "catalogue:ingest": "tsx -r tsconfig-paths/register scripts/catalogue/ingest.ts",
    "catalogue:ingest-full": "tsx --require ./scripts/mock-server-only.cjs -r tsconfig-paths/register scripts/catalogue/ingest-full.ts",
    "catalogue:audit-gap": "tsx --require ./scripts/mock-server-only.cjs -r tsconfig-paths/register scripts/catalogue/audit-gap.ts",
    "catalogue:coverage-report": "tsx --require ./scripts/mock-server-only.cjs -r tsconfig-paths/register scripts/catalogue/coverage-report.ts",
    "catalogue:validate": "tsx -r tsconfig-paths/register scripts/catalogue/validate.ts",
    "catalogue:report": "tsx -r tsconfig-paths/register scripts/catalogue/report.ts",
    "catalogue:repair-range": "tsx --require ./scripts/mock-server-only.cjs -r tsconfig-paths/register scripts/catalogue/repair-range.ts",
    "catalogue:repair-prices": "tsx --require ./scripts/mock-server-only.cjs -r tsconfig-paths/register scripts/catalogue/repair-prices.ts",
    "catalogue:price-audit": "tsx --require ./scripts/mock-server-only.cjs -r tsconfig-paths/register scripts/catalogue/price-audit.ts",
    "catalogue:range-report": "tsx --require ./scripts/mock-server-only.cjs -r tsconfig-paths/register scripts/catalogue/range-report.ts",
    "deployment:verify": "tsx --require ./scripts/mock-server-only.cjs -r tsconfig-paths/register scripts/deployment-verify.ts",
    "test:deployment": "tsx --require ./scripts/mock-server-only.cjs --test scripts/deployment-verify.test.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.20",
    "@ai-sdk/react": "^4.0.40",
    "@neondatabase/serverless": "^1.1.0",
    "ai": "^7.0.37",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
