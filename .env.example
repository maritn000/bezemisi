# Normalised database connection string used by the application.
# In Vercel, the actual variable name may differ (for example POSTGRES_URL).
# The server-side environment module detects and normalises it automatically.
DATABASE_URL=

# Server-only OpenAI credentials. Never expose this as NEXT_PUBLIC_*.
OPENAI_API_KEY=

# Optional server-only override. The application has a supported default.
OPENAI_CHAT_MODEL=

# Enable only after confirming migrations and the intended database branch.
CHAT_PERSISTENCE_ENABLED=

# One-time Vercel Production catalogue bootstrap. Set to true only for a single
# controlled deployment, then remove or set to false immediately afterwards.
RUN_CATALOGUE_BOOTSTRAP=

# Protects /api/internal/catalogue-status and /api/internal/catalogue-report.
CATALOGUE_ADMIN_TOKEN=
